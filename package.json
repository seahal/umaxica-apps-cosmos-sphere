{
  "name": "umaxica-app-jit",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "vite dev",
    "lint": "oxlint . --ignore-pattern 'tmp/**'",
    "lint:fix": "oxlint --fix . --ignore-pattern 'tmp/**'",
    "format": "oxfmt src gait app/javascript *.ts *.json *.yaml *.yml",
    "format:check": "oxfmt --check src gait app/javascript *.ts *.json *.yaml *.yml",
    "typecheck": "tsc --build",
    "build": "NODE_ENV=production vite build --mode production",
    "check": "bun run format:check && bun run lint && bun run typecheck:verify && bun run typecheck && bun run deadcode && bun run openapi:lint && bun run openapi:verify",
    "ci": "bun run check && bun run build",
    "ci:js": "bun run ci",
    "fix": "bun run format && bun run lint:fix",
    "deadcode": "knip",
    "typecheck:verify": "tsc -p tsconfig.app.json --noEmit --listFiles | grep -q '/src/' || (echo 'typecheck covered no source files' >&2 && exit 1)",
    "openapi:lint": "redocly lint",
    "openapi:bundle": "redocly bundle",
    "openapi:verify": "bun scripts/verify_openapi_bundles.ts .",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "test:coverage": "node node_modules/vitest/vitest.mjs run --coverage"
  },
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^8.0.23",
    "@inertiajs/core": "3.11.0",
    "@inertiajs/react": "^3.11.0",
    "@inertiajs/vite": "3.11.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@herb-tools/linter": "^0.11.2",
    "@redocly/cli": "^2.77.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "jsdom": "^30.1.3",
    "knip": "^6.44.2",
    "lefthook": "2.2.2",
    "oxc-transform-react": "^0.157.0",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "playwright": "^1.65.0",
    "tailwindcss-react-aria-components": "^2.2.0",
    "vite": "^8.3.6",
    "vite-plugin-ruby": "^5.2.6",
    "vitest": "5.1.0"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=24.19.0 <25"
  },
  "packageManager": "bun@1.4.0"
}
